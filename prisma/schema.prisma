// BOED LMS — Prisma schema
// Modeled 1:1 from lib/mock-data.ts (canonical) + lib/admin-panel-data.ts
// (course/module presentation fields) + the enrollment onboarding form.
//
// Derived values (course.enrolled, module.viewCount, module.watchTimeMinutes,
// dashboard stats, grade distribution) are intentionally NOT stored — compute
// them from Enrollment / VideoProgress / Submission at query time.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts (CLI/migrate)
  // and in the PrismaPg adapter passed to PrismaClient (runtime).
}

// ============= ENUMS (fixed values observed in mock data) =============

enum Role {
  SUPER_ADMIN
  COURSE_MANAGER
  EXAMINER
  REPORT_VIEWER
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
  INACTIVE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// From admin-panel-data courseRecords: Published | Draft | Archived
enum CourseStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum ModuleType {
  VIDEO
  READING
  QUIZ
  PRACTICE
}

// From AdminModuleResource.type: PDF | LINK | SLIDES | FILE
enum ResourceType {
  PDF
  LINK
  SLIDES
  FILE
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AssessmentType {
  MCQ
  WRITTEN
  PRACTICAL
  MIXED
}

enum QuestionType {
  MCQ
  WRITTEN
  PRACTICAL
}

// From assessment builder: Easy | Medium | Hard
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADING
  GRADED
  REVIEWED
}

enum AssessmentAssignmentTarget {
  COURSE
  BATCH
  LEARNER
}

enum AssessmentAssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum BatchStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum BatchMembershipStatus {
  ACTIVE
  WITHDRAWN
}

enum BatchCourseStatus {
  ACTIVE
  ARCHIVED
}

enum BatchEnrollmentStatus {
  ACTIVE
  WITHDRAWN
}

enum BatchInstructorRole {
  LEAD
  ASSISTANT
  MAKER
  CHECKER
}

enum BatchInstructorStatus {
  ACTIVE
  ARCHIVED
}

/// Manual grading workflow for WRITTEN / PRACTICAL submissions.
/// Keeps the maker-checker lifecycle explicit without exposing draft states
/// directly to learners.
enum ManualReviewStatus {
  NOT_REQUIRED
  PENDING_MAKER
  MAKER_DRAFT
  PENDING_CHECKER
  RETURNED_TO_MAKER
  FINALIZED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum NotificationAudienceType {
  ALL_ACTIVE_STUDENTS
  COURSE_STUDENTS
  ASSESSMENT_PENDING_STUDENTS
  ALL_ACTIVE_INSTRUCTORS
  COURSE_INSTRUCTORS
  SPECIFIC_INSTRUCTOR
}

enum MeetingType {
  VIDEO_CONFERENCE
  WEBINAR
  AUDIO_ONLY
}

enum RecurrencePattern {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum LiveClassStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  UPCOMING
  LIVE
  COMPLETED
  MISSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum JoinRequestStatus {
  PENDING
  REJECTED
}

enum LiveRecordingState {
  IDLE
  STARTING
  ACTIVE
  ENDING
  COMPLETE
  FAILED
}

enum LiveSharePolicy {
  HOST_ONLY
  ALL_PARTICIPANTS
}

// From admin-panel-data permissionModules rows (RBAC matrix on /admin/roles)
enum PermissionModule {
  STUDENTS
  COURSES
  ASSESSMENTS
  SUBMISSIONS
  GRADING
  CERTIFICATES
  REPORTS
  SETTINGS
  ROLES
  QUESTION_BANK
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  OTHER
}

enum QuestionBankStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

enum ImportJobStatus {
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
  FAILED
}

enum ImportDraftStatus {
  PENDING
  NEEDS_REVIEW
  CONFIRMED
  REJECTED
}

// ============= CORE MODELS =============

// Dynamic replacement for the old fixed CourseCategory enum — admins can
// create/rename/remove categories at runtime (e.g. "Healthcare",
// "Human Resources", "Public Health", "Emergency Care", or any new one).
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@map("categories")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  // AES-256-GCM ciphertext (lib/security/encryption.ts) — never store plain phone
  phoneEnc     String?
  // argon2id hash (lib/security/password.ts) — nullable because seeded mock
  // users get a default password; real signups always set one
  passwordHash String?
  role         Role       @default(STUDENT)
  status       UserStatus @default(PENDING)
  photoUrl     String?
  lastActive   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile                       StudentProfile?
  enrollments                   Enrollment[]
  submissions                   Submission[]
  certificates                  Certificate[]
  notifications                 Notification[]
  auditLogs                     AuditLog[]
  videoProgress                 VideoProgress[]
  quizAttempts                  ModuleQuizAttempt[]
  liveClasses                   LiveClass[]             @relation("InstructorClasses")
  attendances                   LiveClassAttendance[]
  liveJoinRequests              LiveClassJoinRequest[]
  sentMessages                  LiveChatMessage[]       @relation("ChatSender")
  receivedMessages              LiveChatMessage[]       @relation("ChatRecipient")
  questionBankItems             QuestionBankItem[]
  questionImportJobs            QuestionImportJob[]
  questionPapers                QuestionPaper[]
  madeSubmissions               Submission[]            @relation("SubmissionMaker")
  checkedSubmissions            Submission[]            @relation("SubmissionChecker")
  notificationCampaigns         NotificationCampaign[]  @relation("NotificationCampaignCreator")
  targetedNotificationCampaigns NotificationCampaign[]  @relation("NotificationCampaignTargetInstructor")
  batchMemberships              BatchMembership[]
  batchCourseAssignments        BatchCourseInstructor[]
  assessmentAssignments         AssessmentAssignment[]  @relation("AssessmentAssignmentLearner")
  createdAssessmentAssignments  AssessmentAssignment[]  @relation("AssessmentAssignmentCreator")
  gradingRulesAsMaker           GradingWorkflowRule[]    @relation("GradingRuleMaker")
  gradingRulesAsChecker         GradingWorkflowRule[]    @relation("GradingRuleChecker")
  gradingRulesAsStudent         GradingWorkflowRule[]    @relation("GradingRuleStudent")
  createdGradingRules           GradingWorkflowRule[]    @relation("GradingRuleCreator")

  @@index([role])
  @@index([status])
  @@map("users")
}

// Sensitive onboarding data from app/(public)/enroll/[courseId] form.
// Kept 1:1 so PII stays in one place and only students carry it.
model StudentProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  dateOfBirth  DateTime?
  // AES-256-GCM ciphertext — national ID is the most sensitive field collected
  nidNumberEnc String?
  address      String?
  city         String?
  postalCode   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Course {
  id            String       @id @default(cuid())
  title         String
  description   String
  // hours, as in mock-data Course.duration
  durationHours Int
  level         CourseLevel
  categoryId    String?
  status        CourseStatus @default(DRAFT)
  coverImage    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modules               Module[]
  enrollments           Enrollment[]
  assessments           Assessment[]
  // Restrict: a course that has issued certificates must not be hard-deleted
  certificates          Certificate[]
  liveClasses           LiveClass[]
  batches               Batch[]
  batchCourses          BatchCourse[]
  questionBankItems     QuestionBankItem[]
  questionPapers        QuestionPaper[]
  notificationCampaigns NotificationCampaign[]
  gradingWorkflowRules  GradingWorkflowRule[]

  @@index([status])
  @@index([categoryId])
  @@map("courses")
}

model Module {
  id              String     @id @default(cuid())
  courseId        String
  title           String
  order           Int
  type            ModuleType
  // minutes, as in mock-data Module.duration
  durationMinutes Int
  // presentation fields from AdminCourseModule
  coverImage      String?
  videoUrl        String?
  /// Raw YouTube URL pasted by the admin (Unlisted video link, etc).
  youtubeUrl      String?
  /// YouTube video ID extracted from youtubeUrl, used to build the embed/thumbnail URLs.
  youtubeVideoId  String?
  overview        String?
  hasQuiz         Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notes             ModuleNote[]
  resources         ModuleResource[]
  quiz              ModuleQuiz?
  quizAttempts      ModuleQuizAttempt[]
  videoProgress     VideoProgress[]
  questionBankItems QuestionBankItem[]
  questionPapers    QuestionPaper[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("modules")
}

model ModuleNote {
  id       String @id @default(cuid())
  moduleId String
  heading  String
  body     String

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("module_notes")
}

model ModuleResource {
  id       String       @id @default(cuid())
  moduleId String
  title    String
  type     ResourceType
  // display string like "12 slides" / "2 pages" as used in the UI
  meta     String
  fileUrl  String?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("module_resources")
}

// Per-module quiz (AdminModuleQuiz): passingScore + embedded questions
model ModuleQuiz {
  id           String @id @default(cuid())
  moduleId     String @unique
  passingScore Int    @default(70)

  module    Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions ModuleQuizQuestion[]
  attempts  ModuleQuizAttempt[]

  @@map("module_quizzes")
}

model ModuleQuizQuestion {
  id           String   @id @default(cuid())
  quizId       String
  question     String
  options      String[]
  correctIndex Int
  marks        Int      @default(5)

  quiz ModuleQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("module_quiz_questions")
}

// One row per submitted attempt, so instructors can see a student's actual
// answers and score per question instead of only the pass/fail flag on
// VideoProgress. Kept separate from VideoProgress (which still gates
// unlocking) because an attempt history is append-only, not a single status.
model ModuleQuizAttempt {
  id            String   @id @default(cuid())
  quizId        String
  moduleId      String
  userId        String
  answers       Json
  score         Int
  obtainedMarks Int
  totalMarks    Int
  passed        Boolean
  createdAt     DateTime @default(now())

  quiz   ModuleQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  module Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([moduleId, userId])
  @@index([userId])
  @@map("module_quiz_attempts")
}

model Enrollment {
  id               String            @id @default(cuid())
  userId           String
  courseId         String
  status           EnrollmentStatus  @default(PENDING)
  /// True when access was assigned directly or requested by the learner.
  /// Cohort-only enrollments remain false so removing the last cohort grant
  /// can withdraw access without affecting manual assignments.
  directAssignment Boolean           @default(true)
  /// The direct/manual source status before cohort access temporarily promotes
  /// the effective enrollment to APPROVED. Null means cohort-only access.
  directStatus     EnrollmentStatus?
  // 0-100
  progress         Int               @default(0)
  enrolledAt       DateTime          @default(now())
  completedAt      DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batchEnrollments BatchEnrollment[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([status])
  @@index([courseId, status, enrolledAt])
  @@map("enrollments")
}

model Assessment {
  id           String         @id @default(cuid())
  courseId     String
  title        String
  type         AssessmentType
  totalMarks   Int
  passingMarks Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions             Question[]
  submissions           Submission[]
  notificationCampaigns NotificationCampaign[]
  assignments           AssessmentAssignment[]

  @@index([courseId])
  @@index([type])
  @@index([courseId, createdAt])
  @@map("assessments")
}

model Question {
  id               String       @id @default(cuid())
  assessmentId     String
  type             QuestionType
  question         String
  marks            Int
  // MCQ options; empty for written/practical
  options          String[]
  correctAnswer    String?
  rubric           String?
  // assessment-builder fields
  difficulty       Difficulty   @default(MEDIUM)
  timeLimitMinutes Int?
  order            Int          @default(0)
  createdAt        DateTime     @default(now())

  assessment   Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  manualGrades SubmissionQuestionGrade[]

  @@index([assessmentId])
  @@map("questions")
}

model Submission {
  id                 String             @id @default(cuid())
  assessmentId       String
  userId             String
  attemptNumber      Int                @default(1)
  status             SubmissionStatus   @default(DRAFT)
  manualReviewStatus ManualReviewStatus @default(NOT_REQUIRED)
  obtainedMarks      Int?
  submittedAt        DateTime?
  gradedAt           DateTime?
  makerTotalMarks    Int?
  makerId            String?
  makerMarkedAt      DateTime?
  makerSubmittedAt   DateTime?
  makerComment       String?
  checkerTotalMarks  Int?
  checkerId          String?
  checkedAt          DateTime?
  checkerComment     String?
  returnReason       String?
  // uploaded answer-sheet scans (OMR / written)
  answerSheetUrls    String[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assessment     Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  maker          User?                     @relation("SubmissionMaker", fields: [makerId], references: [id], onDelete: SetNull)
  checker        User?                     @relation("SubmissionChecker", fields: [checkerId], references: [id], onDelete: SetNull)
  questionGrades SubmissionQuestionGrade[]

  @@unique([assessmentId, userId, attemptNumber])
  @@index([userId])
  @@index([status])
  @@index([manualReviewStatus, updatedAt])
  @@index([makerId])
  @@index([checkerId])
  @@index([submittedAt, id])
  @@map("submissions")
}

/// Per-question marks/comments for manual grading. Maker drafts are captured
/// separately from checker decisions so every override stays reviewable.
model SubmissionQuestionGrade {
  id             String   @id @default(cuid())
  submissionId   String
  questionId     String
  makerMarks     Int?
  makerComment   String?
  checkerMarks   Int?
  checkerComment String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([questionId])
  @@map("submission_question_grades")
}

model Certificate {
  id                   String    @id @default(cuid())
  userId               String
  courseId             String
  issueDate            DateTime  @default(now())
  // Immutable issuer code + yearly sequence, e.g. "PSTC-2026-000001".
  certificateNumber    String    @unique
  issuerName           String
  issuerCode           String
  borderColor          String
  fontFamily           String
  directorSignatureUrl String?
  officialSealUrl      String?
  revokedAt            DateTime?
  revocationReason     String?
  reissuedAt           DateTime?
  supersedesId         String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  supersedes  Certificate? @relation("CertificateReissue", fields: [supersedesId], references: [id], onDelete: SetNull)
  replacement Certificate? @relation("CertificateReissue")

  @@index([courseId])
  @@index([userId, courseId])
  @@index([revokedAt])
  @@index([courseId, issueDate])
  @@map("certificates")
}

model CertificateTemplate {
  id                   String   @id
  issuerName           String   @default("Professional Skills Training Center")
  issuerCode           String   @default("PSTC")
  borderColor          String   @default("#DC2626")
  fontFamily           String   @default("SERIF_FORMAL")
  directorSignatureUrl String?
  officialSealUrl      String?
  updatedAt            DateTime @updatedAt

  @@map("certificate_templates")
}

model CertificateSequence {
  id         String   @id
  issuerCode String
  year       Int
  current    Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([issuerCode, year])
  @@map("certificate_sequences")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  campaignId String?
  title      String
  message    String
  type       NotificationType @default(INFO)
  actionUrl  String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId])
  @@index([userId, readAt])
  @@index([campaignId, readAt])
  @@map("notifications")
}

model NotificationCampaign {
  id                 String                   @id @default(cuid())
  subject            String
  message            String
  type               NotificationType         @default(INFO)
  audienceType       NotificationAudienceType
  courseId           String?
  assessmentId       String?
  targetInstructorId String?
  actionUrl          String?
  recipientCount     Int
  createdById        String?
  sentAt             DateTime                 @default(now())
  createdAt          DateTime                 @default(now())

  course           Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assessment       Assessment?    @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  createdBy        User?          @relation("NotificationCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  targetInstructor User?          @relation("NotificationCampaignTargetInstructor", fields: [targetInstructorId], references: [id], onDelete: SetNull)
  notifications    Notification[]

  @@index([sentAt])
  @@index([audienceType])
  @@index([courseId])
  @@index([assessmentId])
  @@index([targetInstructorId])
  @@map("notification_campaigns")
}

/// Severity of an audited event, so security-relevant activity can be
/// filtered and alerted on separately from routine content edits.
enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

model AuditLog {
  id         String        @id @default(cuid())
  // nullable + SetNull so the audit trail survives user deletion
  userId     String?
  action     String
  entity     String
  entityId   String
  changes    Json?
  /// Who the actor was at the time, captured as plain text so the trail stays
  /// readable after the user row is deleted or renamed.
  actorLabel String?
  /// Actor's role at the time of the action — roles change, the record must not.
  actorRole  String?
  /// Origin of the request. Essential for security review: "who deleted this"
  /// is only half an answer without "from where".
  ipAddress  String?
  userAgent  String?
  severity   AuditSeverity @default(INFO)
  createdAt  DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  // The activity log is read newest-first and filtered by action/severity, so
  // these back the common queries rather than forcing a full scan.
  @@index([createdAt])
  @@index([action])
  @@index([severity, createdAt])
  @@map("audit_logs")
}

// Replaces the localStorage store in lib/video-progress.ts
// (videoId there is the module id)
model VideoProgress {
  id              String    @id @default(cuid())
  userId          String
  moduleId        String
  positionSeconds Float     @default(0)
  durationSeconds Float     @default(0)
  watchedPercent  Float     @default(0)
  /// When the learner first opened this module. The unlock timer is measured
  /// from here against the server clock, so closing the browser or losing the
  /// connection mid-timer never costs the learner time already spent.
  openedAt        DateTime?
  /// Set once the module's unlock delay has been served.
  completed       Boolean   @default(false)
  /// Module quiz passed. A module with a quiz is not complete without this.
  quizPassed      Boolean   @default(false)
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId])
  @@map("video_progress")
}

// ============= LIVE CLASS MODULE =============

model LiveClass {
  id                    String            @id @default(cuid())
  title                 String
  courseId              String
  subjectName           String
  instructorId          String
  batchId               String?
  batchCourseId         String?
  batchName             String
  status                LiveClassStatus   @default(SCHEDULED)
  meetingType           MeetingType       @default(VIDEO_CONFERENCE)
  recurrence            RecurrencePattern @default(NONE)
  durationMinutes       Int
  meetingLink           String
  waitingRoomEnabled    Boolean           @default(true)
  recordingEnabled      Boolean           @default(true)
  autoAttendanceEnabled Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor  User               @relation("InstructorClasses", fields: [instructorId], references: [id], onDelete: Restrict)
  batch       Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  batchCourse BatchCourse?       @relation(fields: [batchCourseId], references: [id], onDelete: SetNull)
  sessions    LiveClassSession[]

  @@index([courseId])
  @@index([instructorId])
  @@index([batchId])
  @@index([batchCourseId])
  @@index([status])
  @@map("live_classes")
}

model LiveClassSession {
  id                    String             @id @default(cuid())
  liveClassId           String
  scheduledStart        DateTime
  scheduledEnd          DateTime
  actualStart           DateTime?
  actualEnd             DateTime?
  status                SessionStatus      @default(UPCOMING)
  recordingUrl          String?
  recordingSizeMb       Float?
  /// Raw YouTube URL pasted by the admin (Unlisted video link, etc).
  youtubeUrl            String?
  /// YouTube video ID extracted from youtubeUrl, used to build the embed/thumbnail URLs.
  youtubeVideoId        String?
  /// LiveKit egress id while a room recording is in progress / recently stopped.
  recordingEgressId     String?
  recordingStatus       LiveRecordingState @default(IDLE)
  /// Set on STARTING, kept through the recording's lifetime, used to reject
  /// stale/mismatched chunk uploads from a superseded attempt.
  recordingAttemptId    String?
  recordingChunkCount   Int                @default(0)
  recordingBytesTotal   BigInt             @default(0)
  /// Last contiguously-accepted chunk sequence number, for gap/duplicate detection.
  recordingLastSeq      Int?
  /// Host-controlled screen-share publish policy for this session.
  screenSharePolicy     LiveSharePolicy    @default(HOST_ONLY)
  screenShareAllowedIds String[]           @default([])
  updatedAt             DateTime           @updatedAt

  liveClass          LiveClass               @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  attendances        LiveClassAttendance[]
  chatMessages       LiveChatMessage[]
  joinRequests       LiveClassJoinRequest[]
  recordingChunkLogs LiveRecordingChunkLog[]

  @@index([liveClassId])
  @@index([status])
  @@index([scheduledStart])
  @@index([recordingAttemptId])
  // Recordings browsing (admin + instructor) filters by liveClassId (via the
  // instructor/course join) and always sorts by scheduledStart — this
  // composite index lets Postgres satisfy both in one pass instead of a
  // separate sort step once session history is large.
  @@index([liveClassId, scheduledStart])
  @@map("live_class_sessions")
}

model LiveClassAttendance {
  id               String           @id @default(cuid())
  sessionId        String
  userId           String
  status           AttendanceStatus
  joinTime         DateTime?
  leaveTime        DateTime?
  durationMinutes  Int?
  speakTimeSeconds Int?
  handRaised       Boolean          @default(false)

  session LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId, joinTime, id])
  @@index([userId])
  @@map("live_class_attendance")
}

model LiveClassJoinRequest {
  id          String            @id @default(cuid())
  sessionId   String
  userId      String
  status      JoinRequestStatus @default(PENDING)
  requestedAt DateTime          @default(now())

  session LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([userId])
  @@map("live_class_join_requests")
}

model LiveChatMessage {
  id              String   @id @default(cuid())
  sessionId       String
  userId          String
  message         String
  isPrivate       Boolean  @default(false)
  toUserId        String?
  sentAt          DateTime @default(now())
  /// Client-generated id used to make repeated sends of the same message
  /// (network retry, double-click) idempotent. Unique per sender per session.
  clientMessageId String?

  session LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation("ChatSender", fields: [userId], references: [id], onDelete: Cascade)
  toUser  User?            @relation("ChatRecipient", fields: [toUserId], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId, clientMessageId])
  @@index([sessionId, sentAt, id])
  @@map("live_chat_messages")
}

/// Per-chunk ledger for local-recording uploads. Gives duplicate/out-of-order
/// detection a DB-level unique constraint instead of relying on in-memory or
/// last-write-wins counters, which matters under concurrent/retried requests.
model LiveRecordingChunkLog {
  id                 String   @id @default(cuid())
  sessionId          String
  recordingAttemptId String
  seq                Int
  byteLength         Int
  receivedAt         DateTime @default(now())

  session LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([recordingAttemptId, seq])
  @@index([sessionId, recordingAttemptId])
  @@map("live_recording_chunk_logs")
}

// ============= QUESTION BANK =============

model Institution {
  id        String          @id @default(cuid())
  name      String
  type      InstitutionType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  questionBankItems QuestionBankItem[]
  questionPapers    QuestionPaper[]

  @@unique([name, type])
  @@map("institutions")
}

model Batch {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String      @unique
  description String?
  courseId    String?
  status      BatchStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int?
  timezone    String      @default("Asia/Dhaka")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  course                Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batchCourses          BatchCourse[]
  questionBankItems     QuestionBankItem[]
  questionPapers        QuestionPaper[]
  memberships           BatchMembership[]
  liveClasses           LiveClass[]
  assessmentAssignments AssessmentAssignment[]
  gradingWorkflowRules  GradingWorkflowRule[]

  @@index([courseId])
  @@map("batches")
}

model BatchMembership {
  id        String                @id @default(cuid())
  batchId   String
  userId    String
  status    BatchMembershipStatus @default(ACTIVE)
  joinedAt  DateTime              @default(now())
  leftAt    DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchEnrollments BatchEnrollment[]

  @@unique([batchId, userId])
  @@index([userId])
  @@map("batch_memberships")
}

model BatchCourse {
  id        String            @id @default(cuid())
  batchId   String
  courseId  String
  status    BatchCourseStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  batch                 Batch                   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  course                Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batchEnrollments      BatchEnrollment[]
  instructorAssignments BatchCourseInstructor[]
  liveClasses           LiveClass[]

  @@unique([batchId, courseId])
  @@index([courseId, status])
  @@map("batch_courses")
}

model BatchCourseInstructor {
  id            String                @id @default(cuid())
  batchCourseId String
  instructorId  String
  role          BatchInstructorRole   @default(ASSISTANT)
  status        BatchInstructorStatus @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  batchCourse BatchCourse @relation(fields: [batchCourseId], references: [id], onDelete: Cascade)
  instructor  User        @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  @@unique([batchCourseId, instructorId, role])
  @@index([instructorId, status])
  @@index([batchCourseId, status, role])
  @@map("batch_course_instructors")
}

model BatchEnrollment {
  id                String                @id @default(cuid())
  batchMembershipId String
  batchCourseId     String
  enrollmentId      String
  status            BatchEnrollmentStatus @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  batchMembership BatchMembership @relation(fields: [batchMembershipId], references: [id], onDelete: Cascade)
  batchCourse     BatchCourse     @relation(fields: [batchCourseId], references: [id], onDelete: Cascade)
  enrollment      Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([batchMembershipId, batchCourseId])
  @@index([enrollmentId, status])
  @@index([batchCourseId, status])
  @@map("batch_enrollments")
}

/// Admin-defined checker policy. Every populated scope field must match.
/// Rules are resolved by priority, then by the number of populated scopes,
/// then newest first. A rule with no scope fields is the global default.
model GradingWorkflowRule {
  id              String   @id @default(cuid())
  name            String
  courseId        String?
  batchId         String?
  studentId       String?
  makerId         String?
  requiresChecker Boolean  @default(true)
  checkerId       String?
  priority        Int      @default(0)
  active          Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course    Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch     Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   User?   @relation("GradingRuleStudent", fields: [studentId], references: [id], onDelete: Cascade)
  maker     User?   @relation("GradingRuleMaker", fields: [makerId], references: [id], onDelete: Cascade)
  checker   User?   @relation("GradingRuleChecker", fields: [checkerId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("GradingRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active, priority])
  @@index([courseId])
  @@index([batchId])
  @@index([studentId])
  @@index([makerId])
  @@map("grading_workflow_rules")
}

model AssessmentAssignment {
  id            String                     @id @default(cuid())
  assessmentId  String
  targetType    AssessmentAssignmentTarget
  targetKey     String
  batchId       String?
  learnerId     String?
  status        AssessmentAssignmentStatus @default(DRAFT)
  availableFrom DateTime?
  dueAt         DateTime?
  attemptLimit  Int                        @default(1)
  createdById   String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  batch      Batch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  learner    User?      @relation("AssessmentAssignmentLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("AssessmentAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([assessmentId, targetKey])
  @@index([assessmentId, status])
  @@index([batchId])
  @@index([learnerId])
  @@map("assessment_assignments")
}

model ExamType {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questionBankItems QuestionBankItem[]
  questionPapers    QuestionPaper[]

  @@map("exam_types")
}

model QuestionPaper {
  id                  String   @id @default(cuid())
  title               String
  specialInstructions String?
  fullMarksOverride   Int?
  questionsToAnswer   Int?
  courseId            String?
  moduleId            String?
  batchId             String?
  examTypeId          String?
  institutionId       String?
  examYear            Int?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  course      Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  module      Module?            @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  batch       Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  examType    ExamType?          @relation(fields: [examTypeId], references: [id], onDelete: SetNull)
  institution Institution?       @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  questions   QuestionBankItem[]

  @@index([courseId])
  @@index([moduleId])
  @@index([batchId])
  @@index([examTypeId])
  @@index([institutionId])
  @@map("question_papers")
}

model QuestionBankItem {
  id            String             @id @default(cuid())
  type          QuestionType
  question      String
  subject       String?
  options       String[]
  correctAnswer String?
  explanation   String?
  rubric        String?
  difficulty    Difficulty         @default(MEDIUM)
  marks         Int?
  examYear      Int?
  status        QuestionBankStatus @default(DRAFT)
  contentHash   String             @unique
  tags          String[]
  usageCount    Int                @default(0)
  // Relations (all optional)
  courseId      String?
  moduleId      String?
  batchId       String?
  examTypeId    String?
  institutionId String?
  createdById   String?
  paperId       String?
  order         Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  course       Course?                   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  module       Module?                   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  batch        Batch?                    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  examType     ExamType?                 @relation(fields: [examTypeId], references: [id], onDelete: SetNull)
  institution  Institution?              @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy    User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  paper        QuestionPaper?            @relation(fields: [paperId], references: [id], onDelete: Cascade)
  translations QuestionBankTranslation[]
  importDrafts QuestionImportDraft[]

  @@index([courseId])
  @@index([moduleId])
  @@index([batchId])
  @@index([examTypeId])
  @@index([institutionId])
  @@index([status])
  @@index([type])
  @@index([difficulty])
  @@index([paperId])
  @@map("question_bank_items")
}

model QuestionBankTranslation {
  id                 String   @id @default(cuid())
  questionBankItemId String
  locale             String
  question           String
  options            String[]
  correctAnswer      String?

  questionBankItem QuestionBankItem @relation(fields: [questionBankItemId], references: [id], onDelete: Cascade)

  @@unique([questionBankItemId, locale])
  @@index([locale])
  @@map("question_bank_translations")
}

model QuestionImportJob {
  id             String          @id @default(cuid())
  fileName       String
  fileUrl        String?
  status         ImportJobStatus @default(PROCESSING)
  totalPages     Int?
  extractedCount Int?
  errorMessage   String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  createdBy User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  drafts    QuestionImportDraft[]

  @@index([status])
  @@map("question_import_jobs")
}

model QuestionImportDraft {
  id                         String            @id @default(cuid())
  importJobId                String
  pageNumber                 Int?
  type                       QuestionType
  question                   String
  options                    String[]
  correctAnswer              String?
  rubric                     String?
  difficulty                 Difficulty        @default(MEDIUM)
  marks                      Int?
  confidenceScore            Float?
  status                     ImportDraftStatus @default(PENDING)
  reviewedQuestionBankItemId String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  importJob                QuestionImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  reviewedQuestionBankItem QuestionBankItem? @relation(fields: [reviewedQuestionBankItemId], references: [id], onDelete: SetNull)

  @@index([importJobId])
  @@index([status])
  @@map("question_import_drafts")
}

// ============= RBAC =============

// Permission matrix from /admin/roles (admin-panel-data permissionModules):
// one row per role x module with View/Create/Edit/Delete/Export flags.
model RolePermission {
  id        String           @id @default(cuid())
  role      Role
  module    PermissionModule
  canView   Boolean          @default(false)
  canCreate Boolean          @default(false)
  canEdit   Boolean          @default(false)
  canDelete Boolean          @default(false)
  canExport Boolean          @default(false)
  updatedAt DateTime         @updatedAt

  @@unique([role, module])
  @@map("role_permissions")
}
