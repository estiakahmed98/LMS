# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pstc_lms?schema=public"

# AES-256-GCM key for field-level encryption (phone, NID number).
# MUST be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Secret for signing sessions / JWTs (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

# NextAuth (Auth.js v5) JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Default password assigned to seeded mock users (change after first login)
SEED_DEFAULT_PASSWORD="ChangeMe123!"

# LiveKit (real A/V for /live/[sessionId])
# Create a project at https://cloud.livekit.io → Settings → Keys
# LIVEKIT_URL example: wss://your-project.livekit.cloud
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Required in production when Live Classroom recording is enabled. Local
# filesystem recording is development-only and is deliberately rejected in
# production. In LiveKit Cloud you can also configure storage in the dashboard.
# LIVEKIT_S3_ACCESS_KEY=""
# LIVEKIT_S3_SECRET=""
# LIVEKIT_S3_BUCKET=""
# LIVEKIT_S3_REGION="auto"
# LIVEKIT_S3_ENDPOINT=""   # e.g. https://<account>.r2.cloudflarestorage.com

# Optional — LiveKit webhook for recording finalize (set in LiveKit Cloud → Webhooks)
# LIVEKIT_WEBHOOK_URL=https://your-domain.com/api/live/webhooks/livekit

# Distributed rate limiting for the Live Classroom APIs (join/chat/hand/
# recording/etc). REQUIRED in production — the server refuses to silently
# fall back to an in-memory limiter when NODE_ENV=production and will
# respond with a 500 (RATE_LIMIT_MISCONFIGURED) until these are set.
# Outside production, a bounded in-memory limiter is used automatically
# when these are left empty, so local dev works without Redis.
# Create a free database at https://console.upstash.com → Redis → REST API.
UPST
ASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Only set to "true" if this app sits behind a reverse proxy that YOU
# control and that strips/overwrites any client-supplied X-Forwarded-For
# header before setting its own. When "true", rate limiting and audit logs
# use that header's client IP for unauthenticated requests; when unset/
# "false" (default), those requests share one bounded IP-less bucket
# instead of trusting an easily-spoofed header.
TRUST_PROXY_HEADERS="false"
